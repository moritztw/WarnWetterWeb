# APP_URL: Öffentliche URL dieser Anwendung (wird in Cloud Run automatisch gesetzt).
APP_URL="http://localhost:3000"

# BRIGHTSKY_BASE_URL: Öffentliche REST-Schnittstelle für DWD Open Data (kein API-Key erforderlich).
BRIGHTSKY_BASE_URL="https://api.brightsky.dev"

# GEOCODING_BASE_URL: Öffentliche Open-Meteo Geocoding-Schnittstelle für die Ortssuche.
GEOCODING_BASE_URL="https://geocoding-api.open-meteo.com/v1"

# DWD_ICON_BASE_URL: Öffentliche DWD-ICON-D2-Schnittstelle für die 2h-Wolkenprognose.
DWD_ICON_BASE_URL="https://api.open-meteo.com/v1/dwd-icon"

# CACHE_TTL_MS: Zwischenspeicher-Dauer des Backend-Proxys in Millisekunden (Standard: 180000 = 3 Minuten).
CACHE_TTL_MS="180000"

# HOST_BIND: Port-Freigabe für Docker Compose (z. B. "3000" oder "127.0.0.1:3000" hinter Reverse-Proxy).
HOST_BIND="3000"

